# Compose settings; copy to .env at repository root.
# Optional credential for the project GLM gateway, supplied to the backend only.
SHIP_GLM_API_KEY=
# External browser origin, without context path. Set to the actual company HTTPS origin.
SHIP_PUBLIC_ORIGIN=http://localhost:8080
# Containers use web mode: validate browser origin without requiring fixed proxy IPs.
SHIP_REQUEST_MODE=web
# Shared by frontend and backend. GitLab project name; no leading/trailing slash. Nested paths allowed.
SHIP_CONTEXT_PATH=ship-smart-engine-room
# Host listener; use 0.0.0.0 only if direct intranet access is intended.
SHIP_BIND_IP=127.0.0.1
SHIP_HTTP_PORT=8080
TZ=Asia/Shanghai
# Dedicated bridge; if occupied, change BOTH subnet and frontend proxy IP.
SHIP_NETWORK_SUBNET=172.30.86.0/24
SHIP_PROXY_IP=172.30.86.2
SHIP_IMAGE_TAG=local
# Options: build, build:test, build:prod.
SHIP_BUILD_SCRIPT=build:prod
# true: run detection and health once at start, then hourly. false: isolated verification only.
SHIP_SCHEDULERS_ENABLED=true
