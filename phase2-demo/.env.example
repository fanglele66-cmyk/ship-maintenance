# For direct Node startup: node --env-file=.env server/local-server.mjs
# Compose uses the repository-root .env instead.
HOST=127.0.0.1
PORT=5173
TZ=Asia/Shanghai
# Optional context path; empty keeps local root-only routing. Leading/trailing / accepted.
# Containers default to ship-smart-engine-room. Root routes also support proxies that strip it.
SHIP_CONTEXT_PATH=
# local: loopback/configured proxy IPs. web: public Origin/Referer, any proxy IP.
# Direct Node startup defaults to local; container images default to web.
SHIP_REQUEST_MODE=local
# Optional exact public origin (scheme + host + port), with NO context-path suffix.
# Required in web mode. Company dev image defaults to https://dev.zhongshu.tech.
SHIP_PUBLIC_ORIGIN=
# Only used in local mode: comma-separated exact proxy IPs and a public origin.
SHIP_TRUSTED_PROXY_IPS=
# Empty uses application defaults; external directories may be absolute paths.
SHIP_DATA_DIR=
SHIP_TELEMETRY_DIR=
SHIP_AI_DIR=
# Optional initial config file, copied only if SHIP_AI_DIR/config.json is missing.
SHIP_AI_SEED_FILE=
SHIP_PYTHON=python
SHIP_SCHEDULERS_ENABLED=true
SHIP_REQUIRE_TELEMETRY=false
SHIP_SHUTDOWN_TIMEOUT_MS=30000
# Optional legacy desktop CC Switch path; unused with committed manual model config.
CC_SWITCH_DB=
