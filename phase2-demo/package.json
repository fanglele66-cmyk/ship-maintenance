{
  "name": "ship-repair-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {"node": "24.x"},
  "scripts": {
    "ai:test": "node scripts/test-ai-connection.mjs",
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "node scripts/build-information-map.mjs && vite build && node scripts/check-deployment-build.mjs",
    "test:deployment": "node --test tests/deployment.test.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "start": "node server/local-server.mjs",
    "data:prepare": "python scripts/prepare-local-data.py",
    "data:compact": "python scripts/compact-stopped-data.py",
    "deployment:export": "node scripts/export-deployment-data.mjs",
    "auth:test": "node --test tests/auth-api.test.mjs",
    "data:test": "node --test tests/local-data.test.mjs",
    "health:run": "node scripts/run-local-health.mjs"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "pinia": "^2.3.1",
    "element-plus": "^2.9.9",
    "echarts": "^5.6.0",
    "vue-echarts": "^7.0.3",
    "sortablejs": "^1.15.6"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "vite": "^6.2.0",
    "autoprefixer": "^10.4.20",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.5.3"
  }
}
