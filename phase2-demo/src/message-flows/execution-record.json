      "type": "text",
      "required": true
    },
    {
      "key": "measures",
      "label": "实际措施",
      "type": "textarea",
      "required": true
    },
    {
      "key": "executedAt",
      "label": "实际执行时间",
      "type": "datetime-local",
      "required": true
    },
    {
      "key": "acceptance",
      "label": "验收与复测结果",
      "type": "textarea",
      "required": true
    },
    {
      "key": "completion",
      "label": "本轮执行状态",
      "type": "select",
      "required": true,
      "options": [
        {
          "value": "completed",
          "label": "执行及验收已完成"
        },
        {
          "value": "partial",
          "label": "尚未完成，保留进展"
        }
      ]
    },
    {
      "key": "verification",
      "label": "原异常验收结果",
      "type": "select",
      "required": true,
      "options": [
        {
          "value": "resolved",
          "label": "原异常已解决，验收通过"
        },
        {
          "value": "unresolved",
          "label": "原异常仍存在，继续排查"
        },
        {
          "value": "pending",
          "label": "尚未完成验收"
        }
      ]
    },
    {
      "key": "comparable",
      "label": "处理后可比监测数据",
      "type": "select",
      "required": true,
      "options": [
        {
          "value": "available",
          "label": "已有可比监测数据"
        },
        {
          "value": "missing",
          "label": "数据缺失或工况不可比"
        }
      ]
    },
    {
      "key": "supplement",
      "label": "对话中的现场补充（原文）",
      "type": "textarea"
    }
