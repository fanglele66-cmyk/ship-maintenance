{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ship-anomaly-detection/interaction-message",
  "title": "长航碧玉 AI 异常事件会话消息",
  "oneOf": [
    {
      "type": "object",
      "required": ["type", "data"],
      "properties": {
        "type": {
          "const": "eventWelcome"
        },
        "data": {
          "type": "object",
          "required": [
            "shipId",
            "eventId",
            "eventType",
            "title",
            "content",
            "keyMetrics",
            "suggestion"
          ],
          "properties": {
            "shipId": {
              "type": "string",
              "minLength": 1
            },
            "eventId": {
              "type": "string",
              "pattern": "^ai-[A-Za-z0-9_-]+$"
            },
            "eventType": {
              "const": "ai-anomaly"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "content": {
              "type": "string",
              "minLength": 1
            },
            "keyMetrics": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "object",
                "required": ["name", "value", "unit"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": ["number", "string"]
                  },
                  "unit": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "suggestion": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "data"],
      "properties": {
        "type": {
          "const": "falseAlarmForm"
        },
        "data": {
          "type": "object",
          "required": [
            "shipId",
            "eventId",
            "eventType",
            "title",
            "selectionMode",
            "options",
            "confirmText",
            "cancelText"
          ],
          "properties": {
            "shipId": {
              "type": "string",
              "minLength": 1
            },
            "eventId": {
              "type": "string",
              "pattern": "^ai-[A-Za-z0-9_-]+$"
            },
            "eventType": {
              "const": "ai-anomaly"
            },
            "title": {
              "const": "请选择误报原因"
            },
            "selectionMode": {
              "const": "single"
            },
            "options": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": {
                "type": "object",
                "required": ["code", "label"],
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "allowTextInput": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              }
            },
            "confirmText": {
              "const": "确认并记录"
            },
            "cancelText": {
              "const": "取消"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}
