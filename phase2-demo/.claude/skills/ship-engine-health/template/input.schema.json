{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ship-engine-health/input",
  "title": "长航碧玉设备健康分析运行参数",
  "type": "object",
  "properties": {
    "workspace": {
      "type": "string",
      "default": ".",
      "description": "可选工作空间根目录；省略时使用当前目录"
    },
    "input_dir": {
      "type": "string",
      "default": "input/sensor-raw-data",
      "description": "raw-data JSON 输入目录"
    },
    "output_dir": {
      "type": "string",
      "default": "result/engine-health/outputs",
      "description": "健康分析 result 输出目录"
    },
    "limit": {
      "type": "integer",
      "default": 12,
      "minimum": 1,
      "description": "每次运行读取的最新 raw-data 文件数量"
    },
    "created_at": {
      "type": "string",
      "description": "可选，用于测试固定输出文件时间戳"
    }
  },
  "additionalProperties": false
}
